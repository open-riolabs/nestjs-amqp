{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@open-rlb/nestjs-amqp$": "<rootDir>/libs/rlb-nestjs-amqp/src",
    "^@open-rlb/nestjs-amqp/(.*)$": "<rootDir>/libs/rlb-nestjs-amqp/src/$1",
    "^src/(.*)": "<rootDir>/src/$1",
    "^src": "<rootDir>/src"
  }
}