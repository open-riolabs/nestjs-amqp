{
  "name": "@open-rlb/nestjs-amqp",
  "version": "0.0.1",
  "description": "",
  "author": "Giuseppe Riolo <riolo.giuseppe@gmail.com>",
  "private": false,
  "license": "MIT",
  "schematics": "./dist/schematics/collection.json",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "sync:skills": "node scripts/sync-skills.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/rlb-nestjs-amqp/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./jest.json",
    "postbuild": "npm run copy:collection && npm run copy:lib",
    "copy:collection": "cpx \"libs/rlb-nestjs-amqp/src/schematics/collection.json\" \"dist/schematics\" && cpx \"libs/rlb-nestjs-amqp/src/schematics/**/schema.json\" \"dist/schematics\"",
    "copy:lib": "cpx \"libs/rlb-nestjs-amqp/src/schematics/**/{.*,files,workspace}/**/\" \"dist/schematics\" && cpx \"libs/rlb-nestjs-amqp/src/schematics/**/{.*,*}\" \"dist/schematics\"",
    "nest-add": "npx schematics ./dist/schematics/collection.json:nest-add project --name=Pet --no-dry-run"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/platform-ws": "^11.1.14",
    "@nestjs/websockets": "^11.1.14",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.6",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.3",
    "@angular-devkit/schematics": "^21.2.3",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.14",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cpx": "^1.5.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "mockingoose": "^2.16.2",
    "mongoose": "^8.24.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/rlb-nestjs-amqp(|/.*)$": "<rootDir>/libs/rlb-nestjs-amqp/src/$1"
    }
  },
  "overrides": {
    "ajv": "^8.18.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
