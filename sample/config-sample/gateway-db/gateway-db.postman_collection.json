            "url": { "raw": "{{baseUrl}}/acl/roles", "host": ["{{baseUrl}}"], "path": ["acl", "roles"] }
          }
        },
        {
          "name": "LIST · GET /acl/roles",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
