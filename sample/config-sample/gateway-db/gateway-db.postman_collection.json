    {
      "name": "Grant",
      "description": "Grant a global [user] role and a [admin] role scoped to doc-1 (with a companyId, grouping-only), then exercise the checks: canUserDoGtw (no resource) and canUserDo (resource doc-1), list the user's resources, and revoke the [admin] role from doc-1. grant and revoke are DUAL: same params (userId+roles required, resourceId+companyId optional) — grant adds roles to the (userId, resourceId) pair, revoke removes them and deletes the record once empty. The global [user] grant survives for the Misc /protected check.",
      "item": [
        {
          "name": "GRANT · POST /acl/grants  ({{userId}} -> [user], global)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('granted', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"roles\": [\"user\"],\n  \"friendlyName\": \"{{kcUsername}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/acl/grants", "host": ["{{baseUrl}}"], "path": ["acl", "grants"] }
          }
        },
        {
          "name": "GRANT · POST /acl/grants  ({{userId}} -> [admin] ON doc-1, companyId=acme)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('granted on doc-1', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"roles\": [\"admin\"],\n  \"resourceId\": \"doc-1\",\n  \"companyId\": \"acme\"\n}" },
            "url": { "raw": "{{baseUrl}}/acl/grants", "host": ["{{baseUrl}}"], "path": ["acl", "grants"] }
          }
        },
        {
          "name": "canUserDoGtw · GET /acl/check  (roles=[user], NO resource -> TRUE)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + true', function () { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.text().trim()).to.match(/^true/); });"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/acl/check?userId={{userId}}&roles=user", "host": ["{{baseUrl}}"], "path": ["acl", "check"], "query": [{ "key": "userId", "value": "{{userId}}" }, { "key": "roles", "value": "user" }] }
          }
        },
        {
          "name": "canUserDo · GET /acl/check-resource  (roles=[admin], resource=doc-1 -> TRUE)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + true', function () { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.text().trim()).to.match(/^true/); });"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/acl/check-resource?userId={{userId}}&roles=admin&resource=doc-1", "host": ["{{baseUrl}}"], "path": ["acl", "check-resource"], "query": [{ "key": "userId", "value": "{{userId}}" }, { "key": "roles", "value": "admin" }, { "key": "resource", "value": "doc-1" }] }
          }
        },
        {
          "name": "canUserDo · GET /acl/check-resource  (roles=[admin], resource=doc-2 -> FALSE)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + false (not granted on doc-2)', function () { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.text()).to.match(/^false/); });"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/acl/check-resource?userId={{userId}}&roles=admin&resource=doc-2", "host": ["{{baseUrl}}"], "path": ["acl", "check-resource"], "query": [{ "key": "userId", "value": "{{userId}}" }, { "key": "roles", "value": "admin" }, { "key": "resource", "value": "doc-2" }] }
          }
        },
        {
          "name": "resources · GET /acl/resources  (my resources, by token identity)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + array', function () { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.json()).to.be.an('array'); });",
            "console.log('resources:', pm.response.text());"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/acl/resources", "host": ["{{baseUrl}}"], "path": ["acl", "resources"] }
          }
        },
        {
          "name": "REVOKE · DELETE /acl/grants  (remove [admin] from doc-1 → record emptied & deleted; keep global [user])",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('revoked', function () { pm.expect(pm.response.code).to.be.oneOf([200,204]); });"
          ] } } ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"roles\": [\"admin\"],\n  \"resourceId\": \"doc-1\"\n}" },
            "url": { "raw": "{{baseUrl}}/acl/grants", "host": ["{{baseUrl}}"], "path": ["acl", "grants"] }
          }
        }
      ]
    },
    {
      "name": "Path",
      "description": "Gateway-admin DB routes: full CRUD on a throwaway /db/echo route (id-keyed) plus a runtime reload broadcast. Reload is async (broker round-trip) — on a transient miss just re-send. Run on a fresh DB (or let this folder finish its DELETE): a leftover ENABLED db-echo makes CREATE return 409 (duplicate method+path).",
      "item": [
        {
          "name": "CREATE · POST /admin/paths  (/db/echo)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var b = pm.response.json(); if (b && b._id) { pm.collectionVariables.set('lastPathId', b._id); }",
            "pm.test('created', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
            "pm.test('CREATE returned _id (drives the id-keyed GET/UPDATE/DELETE below)', function () { pm.expect(b && b._id, 'response must expose _id').to.be.ok; });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"db-echo\",\n  \"method\": \"GET\",\n  \"path\": \"/db/echo\",\n  \"dataSource\": \"query\",\n  \"topic\": \"rlb-gateway-admin\",\n  \"action\": \"gw-metrics-get\",\n  \"mode\": \"rpc\",\n  \"enabled\": true\n}" },
            "url": { "raw": "{{baseUrl}}/admin/paths", "host": ["{{baseUrl}}"], "path": ["admin", "paths"] }
          }
        },
        {
          "name": "LIST · GET /admin/paths",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', function () { pm.expect(pm.response.code).to.eql(200); });"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/paths?page=1&limit=50", "host": ["{{baseUrl}}"], "path": ["admin", "paths"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "50" }] }
          }
        },
        {
          "name": "GET · GET /admin/paths/get?id=  (single by id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + db-echo', function () { pm.expect(pm.response.code).to.eql(200); pm.expect(JSON.stringify(pm.response.json())).to.include('db-echo'); });"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/paths/get?id={{lastPathId}}", "host": ["{{baseUrl}}"], "path": ["admin", "paths", "get"], "query": [{ "key": "id", "value": "{{lastPathId}}" }] }
          }
        },
        {
          "name": "UPDATE · PUT /admin/paths  (edit by id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('updated (200)', function () { pm.expect(pm.response.code).to.eql(200); });"
          ] } } ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{lastPathId}}\",\n  \"name\": \"db-echo\",\n  \"method\": \"GET\",\n  \"path\": \"/db/echo\",\n  \"dataSource\": \"query\",\n  \"topic\": \"rlb-gateway-admin\",\n  \"action\": \"gw-metrics-get\",\n  \"mode\": \"rpc\",\n  \"enabled\": true\n}" },
            "url": { "raw": "{{baseUrl}}/admin/paths", "host": ["{{baseUrl}}"], "path": ["admin", "paths"] }
          }
        },
        {
          "name": "RELOAD · POST /admin/reload  (rebuild routes)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('reload accepted (event -> 2xx)', function () { pm.expect(pm.response.code).to.be.oneOf([200,202,204]); });",
            "var t0 = Date.now(); while (Date.now() - t0 < 1000) {}"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/admin/reload", "host": ["{{baseUrl}}"], "path": ["admin", "reload"] }
          }
        },
        {
          "name": "DELETE · DELETE /admin/paths  (by id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('deleted', function () { pm.expect(pm.response.code).to.be.oneOf([200,204]); });"
          ] } } ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{lastPathId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/paths", "host": ["{{baseUrl}}"], "path": ["admin", "paths"] }
          }
        },
        {
          "name": "RELOAD · POST /admin/reload  (drop the route again)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('reload accepted', function () { pm.expect(pm.response.code).to.be.oneOf([200,202,204]); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/admin/reload", "host": ["{{baseUrl}}"], "path": ["admin", "reload"] }
          }
        }
      ]
    },
    {
      "name": "Stats",
      "description": "Gateway metrics, auto-collected after every request (gateway.metrics). Counters per route, bucketed time-series, and raw data points.",
      "item": [
        {
          "name": "GET /admin/metrics  (counters / avg per route)",
