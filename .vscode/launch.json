{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug gateway-in-memory (in-memory stores)",
      "args": [
        "${workspaceFolder}/sample/config-sample/gateway-in-memory/src/main.ts"
      ],
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register"
      ],
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.debug.json",
        "TS_NODE_TRANSPILE_ONLY": "true",
        "TZ": "UTC",
        "PORT": "3000"
      },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/sample/config-sample/gateway-in-memory",
      "console": "integratedTerminal"
    },
