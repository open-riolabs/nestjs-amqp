              "pm.test('gateway auto-recorded metrics for prior calls', function () {",
              "  pm.expect(Array.isArray(body)).to.be.true;",
              "  // The gateway tracks every served route; by now there should be at least one.",
              "  pm.expect(body.length, 'metric rows').to.be.at.least(1);",
              "});",
              "console.log('Auto-collected routes:', (body || []).map(function (m) { return m.method + ' ' + m.route + ' x' + m.count; }).join(', '));"
            ] } }
