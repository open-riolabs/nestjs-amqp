    {
      "name": "8 · Runtime route reload (add & remove, NO restart)",
      "description": "Proves a DB route can be added AND removed at runtime via POST /admin/reload (broadcast → every gateway rebuilds its Express table). No `nest start` restart.\n\nNote: reload is asynchronous (the signal travels over the broker), so each reload step busy-waits ~1s before the next check. On a race, just re-send the GET.",
      "item": [
        {
          "name": "1) GET /db/echo  (404 — created in DB, not in Express yet)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Not found (404) before reload', function () { pm.expect(pm.response.code).to.be.oneOf([404, 200]); });",
              "if (pm.response.code === 200) console.log('NOTE: already 200 — a previous reload already loaded /db/echo.');"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/db/echo", "host": ["{{baseUrl}}"], "path": ["db", "echo"] }
          }
        },
        {
          "name": "2) POST /admin/reload  (broadcast → rebuild routes)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('reload signal accepted (event mode -> 2xx)', function () { pm.expect(pm.response.code).to.be.oneOf([200,202,204]); });",
              "// Wait for the async rebuild (broker round-trip) before the next check.",
              "var t0 = Date.now(); while (Date.now() - t0 < 1000) {}"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/admin/reload", "host": ["{{baseUrl}}"], "path": ["admin", "reload"] }
          }
        },
        {
          "name": "3) GET /db/echo  (200 — ADDED at runtime, no restart)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 after reload (re-send if 404: reload still in flight)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/db/echo", "host": ["{{baseUrl}}"], "path": ["db", "echo"] }
          }
        },
        {
          "name": "4) DELETE /admin/paths  (remove db-echo from DB)",
