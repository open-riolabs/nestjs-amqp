{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "sample/config-sample/gateway-in-memory/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "sample/config-sample/gateway-in-memory/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "sample/config-sample/gateway-in-memory",
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "gateway-in-memory": {
      "type": "application",
      "root": "sample/config-sample/gateway-in-memory",
      "entryFile": "main",
      "sourceRoot": "sample/config-sample/gateway-in-memory/src",
      "compilerOptions": {
        "tsConfigPath": "sample/config-sample/gateway-in-memory/tsconfig.app.json"
      }
    },
    "gateway-db": {
      "type": "application",
      "root": "sample/config-sample/gateway-db",
      "entryFile": "main",
      "sourceRoot": "sample/config-sample/gateway-db/src",
      "compilerOptions": {
        "tsConfigPath": "sample/config-sample/gateway-db/tsconfig.app.json"
      }
    },
    "calculator.ms": {
      "type": "application",
      "root": "sample/config-sample/calculator.ms",
      "entryFile": "main",
      "sourceRoot": "sample/config-sample/calculator.ms/src",
      "compilerOptions": {
        "tsConfigPath": "sample/config-sample/calculator.ms/tsconfig.app.json"
      }
    },
    "rlb-nestjs-amqp": {
      "type": "library",
      "root": "libs/rlb-nestjs-amqp",
      "entryFile": "index",
      "sourceRoot": "libs/rlb-nestjs-amqp/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rlb-nestjs-amqp/tsconfig.lib.json"
      }
    }
  }
}
